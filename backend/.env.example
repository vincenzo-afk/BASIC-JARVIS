# Ollama
OLLAMA_HOST=http://localhost:11434
DEFAULT_MODEL=llama3.1:8b

# OCR
# Set this when Tesseract is not installed in a detected default location.
TESSERACT_CMD=
OCR_LANGUAGE=eng

# Voice
WHISPER_MODEL=base
PIPER_PATH=piper
PIPER_MODEL=bin/piper/en_US-lessac-medium.onnx

# API
API_HOST=127.0.0.1
API_PORT=8000
DEBUG_MODE=false
LOG_LEVEL=INFO

# Feature flags
ENABLE_OCR=true
ENABLE_VOICE=true
ENABLE_SYSTEM_CONTROL=true
